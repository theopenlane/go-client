{
    "extends": [
        "config:recommended"
    ],
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "labels": [
        "dependencies"
    ],
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            "groupName": "all patch dependencies",
            "groupSlug": "all-patch",
            "matchPackageNames": [
                "*"
            ],
            "matchUpdateTypes": [
                "patch"
            ]
        },
        {
            "matchPackageNames": [
                "github.com/theopenlane/core/common"
            ],
            "minimumReleaseAge": "0 days"
        }
    ]
}
